# Toate valorile sunt in secunde, daca nu scrie altfel. Copiaza in .env si modifica.

# ---------- Recoltare (hold E la "СБОР УРОЖАЯ") ----------
HARVEST_KEY=e
HOLD_SECONDS=2.0          # cat tine apasat E
HOLD_MARGIN=0.15          # adaos peste HOLD_SECONDS
SETTLE_WAIT=0.2           # pauza inainte sa apese E (personajul se opreste)
ACTION_WAIT=1.0           # asteapta atat dupa hold, ca actiunea sa se termine
ACTION_TIMEOUT=3.0        # apoi mai asteapta maxim atat sa dispara textul "СБОР УРОЖАЯ"
HARVEST_RETRIES=2         # cate reincercari daca textul ramane pe ecran

# ---------- Zona de pe ecran unde apare textul ----------
# fractii 0..1: stanga,sus,dreapta,jos. Se completeaza singura la: python calibrate.py grab prompt_harvest
# Gol = cauta pe tot ecranul (mai lent)
PROMPT_REGION=
# Optional: limiteaza captura la fereastra jocului (puncte): left,top,width,height
GAME_REGION=

# ---------- Detectie ----------
MONITOR=1
SCAN_SCALE=0.5            # 0.5 = cauta la jumatate de rezolutie (mai rapid)
ICON_THRESHOLD=0.80
ICON_SCALES=0.7,0.85,1.0,1.2,1.4,1.7
PROMPT_THRESHOLD=0.80

# ---------- Camera: mouse | arrows | none ----------
CAMERA=mouse
MOUSE_RIGHT_BUTTON=false  # true daca camera se roteste tinand click dreapta
CAMERA_PX_PER_WIDTH=600   # px de mouse pentru o rotire cat o latime de ecran
LOOK_CHUNK_PX=60
ARROW_PX_PER_SEC=300

# ---------- Patrula ----------
START_DELAY=5             # timp sa dai click in joc dupa pornire
CHUNK=0.3                 # cat merge intre doua verificari de ecran
ROUTE_MODE=pingpong       # pingpong | loop
LAP_PAUSE=0               # pauza dupa fiecare tur (ex. cat creste iarba)

# ---------- Apropierea de masa ----------
DEADZONE=0.04
STRAFE_PULSE=0.12
FORWARD_PULSE=0.25
APPROACH_TIMEOUT=20
ICON_LOST_MAX=6
IGNORE_SECONDS=15

# ---------- Anti-blocaj ----------
STUCK_DIFF=1.5
STUCK_CHUNKS=2
BLANK_STD=4.0
CENTER_MASK=0.3
JUMP_KEY=space            # gol = fara salt
MAX_STUCK=4
UNSTICK_BASE=0.4

# ---------- Oprire de urgenta ----------
STOP_HOTKEY=<ctrl>+<shift>+x
